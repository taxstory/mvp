{
  "name": "taxstory",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-deprecated-endpoints.cjs && node tests/engine/run.mjs && vite build",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:security": "node --test tests/security/*.test.cjs tests/security/*.test.mjs",
    "test:parser": "node --test tests/parser/*.test.mjs",
    "calibrate": "node scripts/calibrate-returns.mjs",
    "test:all": "node scripts/check-deprecated-endpoints.cjs && npm run test:security && node tests/engine/run.mjs && node --test tests/parser/*.test.mjs"
  },
  "dependencies": {
    "@sentry/react": "10.76.2",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "1.73.0",
    "mediabunny": "1.61.4",
    "pdfjs-dist": "^6.4.299",
    "posthog-js": "1.438.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20"
  }
}
